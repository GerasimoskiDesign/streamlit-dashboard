# Copy to .env and adjust. No real secrets are needed for the demo.
# Where the synthetic daily files live (default: ./data)
SALESREPORT_DATA_DIR=./data
# Where the engine writes the Excel report and the dashboard Parquet files (default: ./output)
SALESREPORT_OUTPUT_DIR=./output
# Demo user file with bcrypt hashes (default: ./config/users.toml)
SALESREPORT_USERS_FILE=./config/users.toml
# Set to 1 while the daily recompute runs: the dashboard shows a "refreshing data" notice
SALESREPORT_MAINTENANCE=0
